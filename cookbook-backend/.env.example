POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# Set to "require" for hosted Postgres (e.g. Neon), leave blank for local dev.
POSTGRES_SSLMODE=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=cookbook-gemini-rag
PINECONE_SPARSE_INDEX_NAME=cookbook-gemini-rag-sparse
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0
PINECONE_NAMESPACE=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

GEMINI_API_KEY=
# Gemini is still used for OCR (image/scanned-PDF transcription) - a local
# text model has no vision capability.
GEMINI_GENERATION_MODEL=gemini-3.6-flash

HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_GENERATION_MAX_NEW_TOKENS=512

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=40
RELEVANCE_SCORE_CUTOFF=0.35

OCR_ENABLED=true
OCR_MAX_BYTES=15000000

CHUNK_STRATEGY=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_BUFFER_SIZE=1
CHUNK_BREAKPOINT_PERCENTILE=90
CHUNK_MAX_CHARS=1500
CHUNK_MIN_CHARS=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DOCUMENTS_DIR=documents
