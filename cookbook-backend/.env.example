POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

PINECONE_API_KEY=
PINECONE_INDEX_NAME=cookbook-gemini-rag
PINECONE_SPARSE_INDEX_NAME=cookbook-gemini-rag-sparse
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0
PINECONE_NAMESPACE=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024

OCR_ENABLED=true
OCR_MAX_BYTES=15000000

CHUNK_STRATEGY=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_BUFFER_SIZE=1
CHUNK_BREAKPOINT_PERCENTILE=90
CHUNK_MAX_CHARS=1500
CHUNK_MIN_CHARS=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DOCUMENTS_DIR=documents
